# Copy to .env only if it does not already exist. Never overwrite real secrets.
# Docker/PostgreSQL administrator password; not an agent credential fallback.
CITYLENS_DB_PASSWORD=replace-with-a-local-database-password

# Fill locally. Empty values keep OpenAI unconfigured until ready.
OPENAI_API_KEY=
OPENAI_MODEL=

# Restricted reader login. URL-encode special characters in its password.
# Example: postgresql://citylens_agent:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:54329/citylens
AGENT_DATABASE_URL=

# Optional separate maintenance credentials for db.py / collision scripts.
# DATABASE_URL=postgresql://citylens:YOUR_URL_ENCODED_ADMIN_PASSWORD@127.0.0.1:54329/citylens
