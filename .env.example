# Copy to .env only if it does not already exist. Never overwrite real secrets.
# Docker/PostgreSQL administrator password; not an agent credential fallback.
CITYLENS_DB_PASSWORD=replace-with-a-local-database-password

# Fill locally. Empty values keep OpenAI unconfigured until ready.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional P1.2.2 evaluation only. Key presence does not authorize live calls.
# Production geocoding remains Census + SanGIS until experiment review.
GOOGLE_MAPS_API_KEY=

# User-location discovery / UI only. The legacy evaluation key above is not reused.
# Restrict the browser key to Maps JavaScript API and your HTTP referrers.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
# Separate server key restricted to Places API (New) and server egress IPs.
GOOGLE_PLACES_API_KEY=
# Optional self-hosted/licensed Nominatim-compatible independent POI source.
# No public Nominatim default is enabled; original user text is searched.
CITYLENS_INDEPENDENT_SEARCH_URL=
CITYLENS_INDEPENDENT_SEARCH_ATTRIBUTION=
CITYLENS_INDEPENDENT_SEARCH_USER_AGENT=

# Restricted reader login. URL-encode special characters in its password.
# Example: postgresql://citylens_agent:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:54329/citylens
AGENT_DATABASE_URL=

# Separate conversation writer. Never use it for the read-only SQL tools.
# Run python -m backend.scripts.setup_sessions before enabling this connection.
SESSION_DATABASE_URL=
# Optional schema-owner connection used ONLY by the explicit setup command.
# SESSION_SETUP_DATABASE_URL=

# Optional separate maintenance credentials for db.py / collision scripts.
# DATABASE_URL=postgresql://citylens:YOUR_URL_ENCODED_ADMIN_PASSWORD@127.0.0.1:54329/citylens
